# Public site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com.au

# Where interest-form emails are delivered
EMPLOYER_INBOX=
CANDIDATE_INBOX=

# Email provider (Resend). Leave blank in dev: submissions are logged to the console instead.
RESEND_API_KEY=
# Must be a sender on a domain verified with the provider
MAIL_FROM="Meridian <hello@example.com.au>"
